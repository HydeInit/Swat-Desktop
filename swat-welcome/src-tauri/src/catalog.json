[
  {
    "id": "firefox",
    "name": "Firefox",
    "description": "Mozilla's browser, ESR channel",
    "category": "browsers",
    "install": { "type": "apt", "package": "firefox-esr" }
  },
  {
    "id": "chromium",
    "name": "Chromium",
    "description": "Open-source base of Chrome",
    "category": "browsers",
    "install": { "type": "apt", "package": "chromium" }
  },
  {
    "id": "vscode",
    "name": "Visual Studio Code",
    "description": "Microsoft's code editor",
    "category": "coding",
    "install": {
      "type": "apt_repo",
      "key_url": "https://packages.microsoft.com/keys/microsoft.asc",
      "repo_line": "deb [arch=amd64 signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main",
      "package": "code"
    }
  },
  {
    "id": "gh-cli",
    "name": "GitHub CLI",
    "description": "gh - GitHub from the terminal",
    "category": "coding",
    "install": { "type": "apt", "package": "gh" }
  },
  {
    "id": "podman-desktop",
    "name": "Podman Desktop",
    "description": "GUI for container management",
    "category": "coding",
    "install": {
      "type": "script",
      "command": "bash",
      "args": [
        "-c",
        "apt-get install -y flatpak && flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo && flatpak install -y flathub io.podman_desktop.PodmanDesktop"
      ],
      "privileged": true
    }
  },
  {
    "id": "aider",
    "name": "Aider",
    "description": "AI pair programming in your terminal",
    "category": "ai",
    "install": {
      "type": "script",
      "command": "sh",
      "args": ["-c", "curl -LsSf https://aider.chat/install.sh | sh"],
      "privileged": false
    }
  },
  {
    "id": "copilot-cli",
    "name": "GitHub Copilot CLI",
    "description": "Copilot from the terminal",
    "category": "ai",
    "install": {
      "type": "script",
      "command": "bash",
      "args": [
        "-c",
        "curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs && npm install -g @github/copilot"
      ],
      "privileged": true
    }
  }
]
