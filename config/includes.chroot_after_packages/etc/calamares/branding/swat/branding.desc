---
componentName: swat

strings:
    productName:         SWAT
    shortProductName:    SWAT
    version:             0.1
    shortVersion:        0.1
    versionedName:       SWAT 0.1
    shortVersionedName:  SWAT 0.1
    bootloaderEntryName: SWAT
    productUrl:          https://github.com/HydeInit/Swat-Desktop
    supportUrl:          https://github.com/HydeInit/Swat-Desktop/issues
    knownIssuesUrl:      https://github.com/HydeInit/Swat-Desktop/issues
    releaseNotesUrl:     https://github.com/HydeInit/Swat-Desktop/blob/master/CHANGELOG.md

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

# QML sidebar/navigation (calamares-sidebar.qml / calamares-navigation.qml,
# both in this directory) replace the basic widget fallback - gives us
# actual control over layout/colors instead of "Branding setting for
# sidebar is missing, using 'widget'" defaults.
sidebar: qml
navigation: qml

slideshow: "show.qml"

# Key names/casing here are Calamares' own schema (SidebarBackground,
# SidebarText, SidebarTextCurrent, SidebarBackgroundCurrent) - the
# previous lowercase-first names here (sidebarBackground, sidebarText,
# sidebarTextSelect, sidebarTextHighlight) didn't match anything
# Calamares recognizes, so none of this was ever actually applying.
style:
   SidebarBackground:        "#0a0e14"
   SidebarText:              "#c5d1de"
   SidebarTextCurrent:       "#0a0e14"
   SidebarBackgroundCurrent: "#00d4ff"
