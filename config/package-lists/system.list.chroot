locales
sudo
console-setup
keyboard-configuration
plymouth
# policykit-1 no longer exists in trixie - split into polkitd (daemon,
# already pulled in indirectly) and pkexec (the actual CLI binary the
# SWAT installer launcher needs, which was missing without this).
pkexec
# grub-common was already present (pulled in indirectly) but not the
# actual grub-install binary - Calamares' bootloader step needs it.
# The metapackages grub-pc/grub-efi-amd64 conflict (they each own
# "auto-configure this system's bootloader" postinst logic) but the
# underlying -bin packages don't - Calamares calls grub-install
# --target=X directly, bypassing that postinst entirely, so installing
# both -bin packages supports BIOS and EFI target installs from the
# same image without needing the conflicting metapackages at all.
grub-pc-bin
grub-efi-amd64-bin
