# Build output (large binaries)
output/
*.iso
*.img

# live-build config files fully derived from auto/config - regenerated by
# running ./auto/config, not hand-edited, so not tracked as source
config/bootstrap
config/common
config/chroot
config/binary
config/source
config/package-lists/live.list.chroot

# Release metadata generated fresh by scripts/build.sh on every build
config/includes.chroot_after_packages/etc/swat-release
config/includes.chroot_after_packages/usr/share/swat/

# Branding assets copied from branding/ (the source of truth) by
# scripts/sync-branding.sh, not hand-edited in place
config/includes.chroot_after_packages/usr/share/backgrounds/swat/wallpaper.png
config/includes.chroot_after_packages/etc/calamares/branding/swat/logo.png
config/includes.chroot_after_packages/usr/share/plymouth/themes/swat/swat.script
config/includes.chroot_after_packages/usr/share/plymouth/themes/swat/swat.plymouth
packaging/swat-branding/usr/share/backgrounds/swat/wallpaper.png

# live-build build/runtime artifacts
config/cache
.build/
binary/
chroot/
cache/
*.log

# .deb build output (built from packaging/*/debian/, not tracked as source)
packaging/*.deb
packaging/*.buildinfo
packaging/*.changes
packaging/*/debian/.debhelper/
packaging/*/debian/*.substvars
packaging/*/debian/*.debhelper.log
packaging/*/debian/debhelper-build-stamp
packaging/*/debian/swat-*/

# Python build/dev artifacts (swat-cli, swat-welcome)
swat-cli/.venv/
swat-cli/**/__pycache__/
swat-cli/**/*.egg-info/
swat-cli/build/
swat-cli/dist/
swat-welcome/.venv/
swat-welcome/**/__pycache__/
swat-welcome/**/*.egg-info/
swat-welcome/build/
swat-welcome/dist/
.pytest_cache/
